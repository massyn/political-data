{% extends "base.jinja" %}
{% block title %}{{ jurisdiction }} — Political Data{% endblock %}

{% block extra_css %}
<style>
  .val-pill  { display: inline-block; min-width: 84px; text-align: center; padding: .15rem .6rem;
               border-radius: 20px; font-size: .85rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .pill-good { background: #dcfce7; color: #15803d; }
  .pill-bad  { background: #fee2e2; color: #b91c1c; }
  .pill-none { background: #e5e7eb; color: #374151; }
  .metric-delta { flex: 0 0 100px; font-size: .78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .delta-good { color: #15803d; }
  .delta-bad  { color: #b91c1c; }
  .delta-none { color: #6b7280; }
  .fresh-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: .4rem; }
  .fresh-current     { background: #16a34a; }
  .fresh-stale       { background: #f59e0b; }
  .fresh-out_of_date { background: #dc2626; }
  @media (max-width: 575.98px) {
    .metric-delta { grid-area: delta; align-self: center; }
    .val-pill { min-width: 0; }
  }
</style>
{% endblock %}

{% block content %}
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
    <li class="breadcrumb-item active">{{ jurisdiction }}</li>
  </ol>
</nav>

<h1 class="fw-bold mb-4 d-flex align-items-center gap-3" style="font-size:1.75rem;">
  {% if flag %}<img src="{{ flag }}" alt="" class="border" style="height:34px; border-radius:4px;">{% endif %}
  {{ jurisdiction }}
</h1>

{% for category, rows in categories.items() %}
<div class="card mb-3">
  <div class="px-3 py-2 section-title">{{ category }}</div>
  {% for row in rows %}
  <a href="{{ row.url }}" class="metric-row">
    <span class="metric-name">{{ row.title }}</span>
    <span class="metric-spark">{{ row.sparkline | safe }}</span>
    <span class="metric-val">
      {% if row.latest_value is not none %}
      <span class="val-pill pill-{{ row.rag or 'none' }}">{{ row.latest_value }}</span>
      {% endif %}
    </span>
    <span class="metric-delta delta-{{ row.rag or 'none' }}">
      {% if row.delta is not none and row.delta_text %}{% if row.delta > 0 %}&#9650;{% elif row.delta < 0 %}&#9660;{% else %}&#9654;{% endif %} {{ row.delta_text }}{% endif %}
    </span>
    <span class="metric-date" title="{{ row.freshness.label }}{% if row.freshness.due %} - next data due {{ row.freshness.due }}{% endif %}">
      <span class="fresh-dot fresh-{{ row.freshness.status }}"></span>{{ row.latest_date or '' }}
    </span>
  </a>
  {% endfor %}
</div>
{% endfor %}
{% endblock %}
